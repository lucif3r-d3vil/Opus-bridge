# Copy to .env and edit. Every value is optional.

# Dashboard bind address. 127.0.0.1 = this machine only. Use your LAN IP to open it from other devices.
DASHBOARD_BIND=127.0.0.1
DASHBOARD_PORT=7001

# Admin password for the dashboard. Leave empty to generate one (printed once: docker logs opus-bridge).
ADMIN_PASSWORD=

# Optional: seed the metadata keys on first boot. You can also enter them in the dashboard.
TMDB_API_KEY=
TVDB_API_KEY=

TZ=UTC

# Join an existing Jellyfin network (uncomment both lines):
# COMPOSE_FILE=docker-compose.yml:docker-compose.shared-network.yml
# JELLYFIN_NETWORK=your_network_name
